# Copy to `.env` and fill in. Never commit `.env`.
#
# There are no credentials compiled into OVIS: every value below comes from the
# environment or an `ovis.toml`, and the server refuses to start without the
# required ones rather than guessing at a default.

# --- required ------------------------------------------------------------------

# Postgres, connected to *directly*. On the homelab deployment that is port 5433
# on gamma. Do not point this at pgbouncer (5432): SQLx uses prepared statements
# and pgbouncer runs transaction pooling, which breaks them. OVIS's pool is ≤20
# connections and has no need for a pooler.
DATABASE_URL=postgres://postgres:CHANGE_ME@192.168.4.113:5433/postgres

# OpenSearch. Authless on this deployment (plugins.security.disabled=true);
# OPENSEARCH_USERNAME / OPENSEARCH_PASSWORD are wired through if that changes.
OPENSEARCH_URL=http://192.168.4.113:9200

# --- optional: connector actions ------------------------------------------------

# Without both of these, every action endpoint (pause, resume, run-once, prune,
# cc-pair delete, targeted reindex, boost, hide) answers 503 ONYX_UNCONFIGURED.
# Reads are unaffected.
#
# ONYX_API_KEY accepts an Onyx API key *or* a personal access token. On the free
# tier `POST /admin/api-key` is paywalled (402 FEATURE_NOT_AVAILABLE), so a PAT is
# the working option — see "The Onyx API token" in docs/getting-started.md.
ONYX_API_URL=http://192.168.4.113:8080
ONYX_API_KEY=

# --- optional: semantic and hybrid search ---------------------------------------

# The vLLM embedding endpoint behind the hppc nginx load balancer. Unset means
# mode=semantic|hybrid fall back to keyword search and report
# degraded="no_embedder".
EMBED_API_URL=http://192.168.4.240:8090
EMBED_MODEL=snowflake-arctic-embed:m

# --- optional: access control ---------------------------------------------------

# When set, every /api/v1/* route requires `Authorization: Bearer <token>`
# (/system/health stays open for container probes, and SSE also accepts ?token=).
# Set this, and tighten CORS, as soon as OVIS is reachable beyond localhost.
OVIS_API_TOKEN=
OVIS_CORS_ORIGINS=*

# Which interface docker-compose publishes on. Leave at localhost unless a bearer
# token is set.
OVIS_BIND=127.0.0.1

# Which interface the server binds when run directly rather than via compose.
# OVIS_BIND above only affects the compose port mapping, so without this a direct
# `cargo run` still listens on 0.0.0.0.
OVIS_HOST=127.0.0.1

# --- optional: tuning -----------------------------------------------------------

# OVIS_PORT=8080
# OVIS_DB_MAX_CONNECTIONS=20
# OVIS_MAX_PAGE_SIZE=500
# OVIS_BATCH_DELETE_MAX=1000
# OVIS_MAX_STREAM_LIMIT=10000
# OVIS_REQUEST_TIMEOUT_SECS=30
# OVIS_SHUTDOWN_GRACE_SECS=10
# OVIS_RUNTIME_REFRESH_SECS=60
# OVIS_LOG_FORMAT=json
# RUST_LOG=ovis_backend=debug

# --- optional: pruning ------------------------------------------------------------
# The safety lifecycle for junk removal (docs/pruning.md). Every default is
# conservative; deletion only ever happens in the background reaper.

# Days a staged (hidden) document waits before the reaper may delete it (0-90).
# OVIS_PRUNE_GRACE_DAYS=7
# Seconds between reaper cycles.
# OVIS_PRUNE_REAPER_INTERVAL_SECS=300
# Documents per reaper delete batch (clamped to OVIS_BATCH_DELETE_MAX).
# OVIS_PRUNE_REAPER_BATCH_SIZE=100
# Milliseconds the reaper pauses between batches.
# OVIS_PRUNE_REAPER_PAUSE_MS=2000
# Hard ceiling on reaper deletions per trailing hour.
# OVIS_PRUNE_MAX_DOCS_PER_HOUR=2000
# Bulk mutations beyond this require the typed count on both surfaces.
# OVIS_PRUNE_BIG_BATCH=500
# Documents per scan keyset page.
# OVIS_PRUNE_SCAN_PAGE_SIZE=1000
